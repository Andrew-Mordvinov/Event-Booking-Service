{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console" ],
        "MinimumLevel": {
            "Default": "Information"
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            }
        ]
    },

    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5436;Database=eventsDb;Username=postgres;Password=admin"
    },

    "JwtSettings": {
        "SecretKey": "dev-secret-key-not-for-production",
        "Issuer": "BookingService",
        "Audience": "BookingService",
        "ExpiryMinutes": 15
    },

    "KafkaSettings": {
        "BootstrapServer": "localhost:9092"
    },

    "KafkaConsumerSettings": {
        "GroupId": "book-processing",
        "AutoOffsetReset": 1
    },

    "TTLSettings": {
        "SingleEventMsec": 1000,
        "TopSalesSec": 10
    },

    "RedisSettings": {
        "EndPoints": [ "localhost:6379" ],
        "Password": "pass"
    },

    "AllowedHosts": "*"
}
