{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
            }
        ]
    },

    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5436;Database=eventsDb;Username=postgres;Password=admin"
    },

    "JwtSettings": {
        "SecretKey": "dev-secret-key-not-for-production",
        "Issuer": "BookingService",
        "Audience": "BookingService",
        "ExpiryMinutes": 15
    },

    "KafkaSettings": {
        "BootstrapServer": "localhost:9092"
    },

    "KafkaConsumerSettings": {
        "GroupId": "book-processing",
        "AutoOffsetReset": 1
    },

    "TTLSettings": {
        "SingleEventMsec": 1000,
        "TopSalesSec": 10
    },

    "RedisSettings": {
        "EndPoints": [ "redis:6379" ],
        "Password": null
    },

    "AllowedHosts": "*"
}
