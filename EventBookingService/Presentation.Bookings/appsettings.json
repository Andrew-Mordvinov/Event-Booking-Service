{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console" ],
        "MinimumLevel": {
            "Default": "Information"
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                }
            }
        ]
    },

    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5436;Database=eventapi;Username=postgres;Password=admin"
    },

    "AllowedHosts": "*",

    "BookingSettings": {
        "MaxBookingPerUser": 10
    },

    "JwtSettings": {
        "SecretKey": "dev-secret-key-not-for-production",
        "Issuer": "BookingService",
        "Audience": "BookingService",
        "ExpiryMinutes": 15
    }
}
